	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"const apiKey = pm.environment.get(\"firebase_api_key\");",
					"const email = pm.environment.get(\"test_email\");",
					"const password = pm.environment.get(\"test_password\");",
					"const currentToken = pm.environment.get(\"auth_token\");",
					"const tokenExpiry = pm.environment.get(\"token_expiry\");",
					"const currentTime = Date.now();",
					"",
					"const authUrl = `https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=${apiKey}`;",
					"",
					"if (currentToken && tokenExpiry && currentTime < tokenExpiry) {",
					"    console.log(\"Using existing valid token\");",
					"} else {",
					"    console.log(\"Token missing or expired, fetching new token...\");",
					"    ",
					"    pm.sendRequest({",
					"        url: authUrl,",
					"        method: 'POST',",
					"        header: {",
					"            'Content-Type': 'application/json'",
					"        },",
					"        body: {",
					"            mode: 'raw',",
					"            raw: JSON.stringify({",
					"                email: email,",
					"                password: password,",
					"                returnSecureToken: true",
					"            })",
					"        }",
					"    }, function (err, res) {",
					"        if (err) {",
					"            console.error(\"Authentication error:\", err);",
					"        } else {",
					"            const jsonResponse = res.json();",
					"            if (jsonResponse.idToken) {",
					"                pm.environment.set(\"auth_token\", jsonResponse.idToken);",
					"                pm.environment.set(\"token_expiry\", currentTime + (55 * 60 * 1000));",
					"                console.log(\"New token obtained and stored\");",
					"            } else {",
					"                console.error(\"Failed to get token:\", jsonResponse);",
					"            }",
					"        }",
					"    });",
					"}"
				]
			}
		}
	]
